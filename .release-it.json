{
	"git": {
		"commitMessage": "chore: release v${version}",
		"pushArgs": ["--follow-tags", "--atomic"],
		"requireCommits": true
	},
	"github": {
		"release": true,
		"releaseName": "v${version}"
	},
	"hooks": {
		"after:git:release": "npm publish"
	},
	"npm": {
		"publish": false,
		"skipChecks": true
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": {
				"name": "conventionalcommits",
				"types": [
					{
						"effect": "hidden",
						"scope": "qa",
						"type": "docs"
					},
					{
						"effect": "hidden",
						"scope": "qa",
						"type": "feat"
					},
					{
						"effect": "hidden",
						"scope": "qa",
						"type": "fix"
					},
					{
						"section": "Features",
						"type": "feat"
					},
					{
						"section": "Bug Fixes",
						"type": "fix"
					},
					{
						"section": "Performance Improvements",
						"type": "perf"
					},
					{
						"effect": "hidden",
						"type": "build"
					},
					{
						"effect": "hidden",
						"type": "chore"
					},
					{
						"effect": "hidden",
						"type": "ci"
					},
					{
						"effect": "hidden",
						"type": "docs"
					},
					{
						"effect": "hidden",
						"type": "refactor"
					},
					{
						"effect": "hidden",
						"type": "style"
					},
					{
						"effect": "hidden",
						"type": "test"
					}
				]
			}
		}
	}
}
