{
	"name": "slidev2pptx",
	"version": "0.1.0",
	"description": "Builds native, editable PowerPoint files from Slidev decks. 🛝",
	"keywords": [
		"powerpoint",
		"pptx",
		"slidev"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/slidev2pptx.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"bin": "bin/index.js",
	"files": [
		"bin/",
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"@takumi-rs/core": "^2.20.0",
		"@takumi-rs/helpers": "^2.20.0",
		"css-tree": "^3.2.1",
		"es-module-lexer": "^3.0.0",
		"fontkit": "^3.0.0",
		"image-size": "^2.1.0",
		"jpeg-js": "^0.4.4",
		"jszip": "^3.10.1",
		"linkedom": "^0.18.15",
		"lz-string": "^1.5.0",
		"markdown-exit": "^2.1.3",
		"pngjs": "^7.0.0",
		"pptxgenjs": "^4.0.1"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@release-it/conventional-changelog": "12.0.0",
		"@slidev/cli": "53.1.0",
		"@slidev/client": "53.1.0",
		"@slidev/parser": "53.1.0",
		"@slidev/types": "53.1.0",
		"@types/css-tree": "3.2.0",
		"@types/fontkit": "2.0.8",
		"@types/node": "26.6.2",
		"@types/pngjs": "6.0.5",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"cspell": "10.5.0",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "65.4.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-vue": "10.12.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"knip": "6.45.1",
		"lint-staged": "17.6.0",
		"playwright-chromium": "1.65.0",
		"pptx-svg": "0.6.8",
		"prettier": "3.10.1",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
