		"vue": "3.5.45",
		"vue-eslint-parser": "10.4.2",
		"yaml": "2.9.1"
	},
	"peerDependencies": {
		"@slidev/cli": "^53.1.0",
		"@slidev/client": "^53.1.0",
		"@slidev/parser": "^53.1.0",
		"@slidev/types": "^53.1.0",
		"vue": "^3.5.0"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "^22.22.0 || >=24.0.0"
	}
}
